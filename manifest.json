{
  "manifest_version": 3,
  "name": "TCP Hardware Checker",
  "version": "1.0.0",
  "description": "Check if your computer meets TCP technical requirements",
  "permissions": ["system.cpu", "system.memory", "system.storage", "system.display", "tabs"],
  "host_permissions": [
    "https://xomtepfevlphmajhdgnu.supabase.co/*",
    "http://localhost:5173/*",
    "https://fast.com/*",
    "https://api.fast.com/*",
    "https://*.nflxvideo.net/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/check*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TCP Hardware Checker"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
